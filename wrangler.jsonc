{
  // Static Eating in Destin guide. Worker name is eatingindestin.
  // Preview only: do not add a custom domain binding in this file.
  // The preview URL is the workers.dev hostname Cloudflare assigns this Worker.
  // Signup and listing mail is sent only when RESEND_API_KEY, SUBSCRIBE_FROM, and CONTACT_EMAIL are set.
  // Coupon signups are also appended to Google Sheets when GOOGLE_SHEETS_WEBHOOK_URL and GOOGLE_SHEETS_WEBHOOK_TOKEN are set.
  // Sign-in and My places rows for the 30A tab use optional secret GOOGLE_SHEETS_WEBHOOK_TOKEN_30A. Do not put that token here.
  // The same signups are added to Zoho Campaigns when ZOHO_CLIENT_ID, ZOHO_CLIENT_SECRET, and ZOHO_REFRESH_TOKEN are set.
  // ZOHO_LIST_KEY_DESTIN is the Destin list. ZOHO_LIST_KEY_30A is the 30A list for account checkboxes. Do not put those secrets here.
  "name": "eatingindestin",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  // Shared accounts live on the eating-accounts Worker in the eatingon30A repo.
  // Change ACCOUNTS_ORIGIN if that workers.dev hostname differs. Set the same
  // ACCOUNTS_SHARED_SECRET with wrangler secret put. Do not put the secret here.
  "vars": {
    "ACCOUNT_SITE": "destin",
    "ACCOUNTS_ORIGIN": "https://eating-accounts.352marc.workers.dev"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
