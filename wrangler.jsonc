{
  // Static Eating in Destin guide. Worker name is eatingindestin.
  // Preview only: do not add a custom domain binding in this file.
  // The preview URL is the workers.dev hostname Cloudflare assigns this Worker.
  // Signup and listing mail is sent only when RESEND_API_KEY, SUBSCRIBE_FROM, and CONTACT_EMAIL are set.
  // Coupon signups are also appended to Google Sheets when GOOGLE_SHEETS_WEBHOOK_URL and GOOGLE_SHEETS_WEBHOOK_TOKEN are set.
  "name": "eatingindestin",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
